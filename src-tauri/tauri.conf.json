{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnTheWay",
  "identifier": "dev.ontheway.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OnTheWay",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "theme": null,
        "backgroundColor": "#F1F1ED",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: http: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.[pP][nN][gG]",
          "**/*.[jJ][pP][gG]",
          "**/*.[jJ][pP][eE][gG]",
          "**/*.[gG][iI][fF]",
          "**/*.[wW][eE][bB][pP]",
          "**/*.[aA][vV][iI][fF]",
          "**/*.[sS][vV][gG]",
          "**/*.[bB][mM][pP]",
          "**/*.[iI][cC][oO]"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMTNBM0M4MDBBNTYwQTgKUldTb1lLVUF5S01Ua3RSZDkrSmg4N29wTEZoTDZyM2UyNm1aR2d6RjdEaEFzZkJvUC9rTXRmckcK",
      "endpoints": ["https://github.com/Gred666/OnTheWay/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 OnTheWay",
    "category": "Productivity",
    "shortDescription": "笔记、待办、目标与日历一体的个人效率工具",
    "longDescription": "OnTheWay 把笔记、今日待办、目标与日历整合在一条数据链上，并以复盘收口。本地优先，数据全部保存在本机。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
