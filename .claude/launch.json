{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ontheway",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 1420
    },
    {
      "name": "ontheway-browser",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vite", "--port", "1431"],
      "port": 1431
    },
    {
      "name": "ontheway-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vite", "preview", "--port", "1432", "--strictPort"],
      "port": 1432
    },
    {
      "name": "ontheway-desktop",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:CARGO_HOME='D:\\Dev\\cargo'; $env:RUSTUP_HOME='D:\\Dev\\rustup'; $env:Path='D:\\Dev\\cargo\\bin;' + $env:Path; pnpm tauri dev"
      ],
      "port": 1420
    }
  ]
}
